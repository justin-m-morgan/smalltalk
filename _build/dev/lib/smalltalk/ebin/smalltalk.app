{application,smalltalk,
    [{modules,
         ['Elixir.Smalltalk','Elixir.Smalltalk.Application',
          'Elixir.Smalltalk.Mailer','Elixir.Smalltalk.Repo',
          'Elixir.SmalltalkWeb','Elixir.SmalltalkWeb.CoreComponents',
          'Elixir.SmalltalkWeb.Endpoint','Elixir.SmalltalkWeb.ErrorHTML',
          'Elixir.SmalltalkWeb.ErrorJSON','Elixir.SmalltalkWeb.Gettext',
          'Elixir.SmalltalkWeb.Layouts','Elixir.SmalltalkWeb.PageController',
          'Elixir.SmalltalkWeb.PageHTML','Elixir.SmalltalkWeb.Router',
          'Elixir.SmalltalkWeb.Telemetry']},
     {compile_env,
         [{smalltalk,['Elixir.SmalltalkWeb.Endpoint',code_reloader],{ok,true}},
          {smalltalk,['Elixir.SmalltalkWeb.Endpoint',debug_errors],{ok,true}},
          {smalltalk,['Elixir.SmalltalkWeb.Endpoint',force_ssl],error},
          {smalltalk,['Elixir.SmalltalkWeb.Gettext'],error},
          {smalltalk,[dev_routes],{ok,true}}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,sourceror,ash_postgres,
          ash_phoenix,ash,igniter,phoenix,phoenix_ecto,ecto_sql,postgrex,
          phoenix_html,phoenix_live_reload,phoenix_live_view,
          phoenix_live_dashboard,esbuild,tailwind,swoosh,req,
          telemetry_metrics,telemetry_poller,gettext,jason,dns_cluster,
          bandit]},
     {description,"smalltalk"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.Smalltalk.Application',[]}}]}.
