{application,smalltalk,
    [{modules,
         ['Elixir.Inspect.Smalltalk.Accounts.Token',
          'Elixir.Inspect.Smalltalk.Accounts.User',
          'Elixir.Inspect.Smalltalk.Conversations.Conversation',
          'Elixir.Inspect.Smalltalk.Conversations.Message',
          'Elixir.Inspect.Smalltalk.Conversations.Profile',
          'Elixir.Inspect.Smalltalk.Conversations.ReadReceipt',
          'Elixir.Inspect.Smalltalk.Conversations.Talker','Elixir.Smalltalk',
          'Elixir.Smalltalk.Accounts','Elixir.Smalltalk.Accounts.Token',
          'Elixir.Smalltalk.Accounts.User',
          'Elixir.Smalltalk.Accounts.User.Senders.SendMagicLinkEmail',
          'Elixir.Smalltalk.Accounts.User.Senders.SendNewUserConfirmationEmail',
          'Elixir.Smalltalk.Accounts.User.Senders.SendPasswordResetEmail',
          'Elixir.Smalltalk.Application','Elixir.Smalltalk.Conversations',
          'Elixir.Smalltalk.Conversations.Conversation',
          'Elixir.Smalltalk.Conversations.Message',
          'Elixir.Smalltalk.Conversations.Profile',
          'Elixir.Smalltalk.Conversations.ReadReceipt',
          'Elixir.Smalltalk.Conversations.Talker','Elixir.Smalltalk.Mailer',
          'Elixir.Smalltalk.Repo','Elixir.Smalltalk.Secrets',
          'Elixir.SmalltalkLayouts.Layouts','Elixir.SmalltalkUi.Button',
          'Elixir.SmalltalkUi.Containers','Elixir.SmalltalkUi.Dock',
          'Elixir.SmalltalkUi.Drawer','Elixir.SmalltalkUi.Flash',
          'Elixir.SmalltalkUi.Forms','Elixir.SmalltalkUi.Icon',
          'Elixir.SmalltalkUi.JsCommands','Elixir.SmalltalkUi.Menu',
          'Elixir.SmalltalkUi.Modal','Elixir.SmalltalkUi.Stepper',
          'Elixir.SmalltalkUi.Table','Elixir.SmalltalkUi.Theme',
          'Elixir.SmalltalkWeb','Elixir.SmalltalkWeb.AccountLive',
          'Elixir.SmalltalkWeb.AuthController',
          'Elixir.SmalltalkWeb.AuthOverrides',
          'Elixir.SmalltalkWeb.CoreComponents','Elixir.SmalltalkWeb.Endpoint',
          'Elixir.SmalltalkWeb.ErrorHTML','Elixir.SmalltalkWeb.ErrorJSON',
          'Elixir.SmalltalkWeb.FriendsLive','Elixir.SmalltalkWeb.Gettext',
          'Elixir.SmalltalkWeb.HomeLive','Elixir.SmalltalkWeb.Layouts',
          'Elixir.SmalltalkWeb.LiveUserAuth',
          'Elixir.SmalltalkWeb.PageController','Elixir.SmalltalkWeb.PageHTML',
          'Elixir.SmalltalkWeb.ProfileLive','Elixir.SmalltalkWeb.Router',
          'Elixir.SmalltalkWeb.Telemetry']},
     {compile_env,
         [{smalltalk,['Elixir.SmalltalkWeb.Endpoint',code_reloader],{ok,true}},
          {smalltalk,['Elixir.SmalltalkWeb.Endpoint',debug_errors],{ok,true}},
          {smalltalk,['Elixir.SmalltalkWeb.Endpoint',force_ssl],error},
          {smalltalk,['Elixir.SmalltalkWeb.Gettext'],error},
          {smalltalk,[dev_routes],{ok,true}}]},
     {optional_applications,[]},
     {applications,
         [kernel,stdlib,elixir,logger,runtime_tools,bcrypt_elixir,
          picosat_elixir,ash_authentication_phoenix,sourceror,ash_postgres,
          ash,ash_authentication,igniter,phoenix,phoenix_ecto,ecto_sql,
          postgrex,phoenix_html,phoenix_live_reload,phoenix_live_view,
          phoenix_live_dashboard,esbuild,tailwind,swoosh,req,
          telemetry_metrics,telemetry_poller,gettext,jason,dns_cluster,bandit,
          dotenvy,seed_factory]},
     {description,"smalltalk"},
     {registered,[]},
     {vsn,"0.1.0"},
     {mod,{'Elixir.Smalltalk.Application',[]}}]}.
